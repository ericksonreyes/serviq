# ServIQ Platform Management — local Docker environment.
# Copy to .env (scripts/install.sh does this for all services). Hosts are
# compose service names — never localhost inside containers.

APP_NAME="ServIQ Platform Management"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8011

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=serviq_payouts
DB_USERNAME=serviq
DB_PASSWORD=serviq

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=serviq
RABBITMQ_PASSWORD=serviq
RABBITMQ_EXCHANGE=serviq.events
RABBITMQ_QUEUE=payouts.events

# JWT validation — this service verifies tokens issued by IAM; it never
# signs them. Resolution order: JWT_PUBLIC_KEY (RS256) → JWKS from IAM →
# JWT_SECRET (HS256 local/test fallback, never production).
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY=
JWT_SECRET=
JWT_JWKS_URL=http://identity-access-backend/.well-known/jwks.json
JWT_ISSUER=serviq-iam
JWT_AUDIENCE=serviq
