# ServIQ Payouts — local Docker environment.
# Copy to .env (scripts/install.sh does this for all services). Hosts are
# compose service names — never localhost inside containers.

APP_NAME="ServIQ Payouts"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8021

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=serviq_payouts
DB_USERNAME=serviq
DB_PASSWORD=serviq

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=serviq
RABBITMQ_PASSWORD=serviq

# Payout port — local deterministic stub adapter; real provider swaps in via adapter
PAYOUT_PROVIDER=stub

JWT_PUBLIC_KEY=
JWT_ISSUER=serviq-iam
JWT_AUDIENCE=serviq
