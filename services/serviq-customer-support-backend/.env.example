# ServIQ Customer Support Backend (NestJS) — local Docker environment.
# Copy to .env (scripts/install.sh does this for all services). Hosts are
# compose service names — never localhost inside containers.

APP_NAME="ServIQ Customer Support"
APP_ENV=local
PORT=3000

DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=serviq_support
DB_USERNAME=serviq
DB_PASSWORD=serviq

MONGODB_URI=mongodb://mongo:27017/serviq_support

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=serviq
RABBITMQ_PASSWORD=serviq
RABBITMQ_EXCHANGE=serviq.events
RABBITMQ_QUEUE=customer-support.events
# Topic patterns this consumer binds to (comma-separated).
RABBITMQ_BINDINGS=Job.*,Invoice.*,Request.*,Support.*

# JWT validation — this service verifies tokens issued by IAM; it never
# signs them. Resolution order: JWT_PUBLIC_KEY (RS256) → JWKS from IAM →
# JWT_SECRET (HS256 local/test fallback, never production).
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY=
JWT_SECRET=
JWT_JWKS_URL=http://identity-access-backend/.well-known/jwks.json
JWT_ISSUER=serviq-iam
JWT_AUDIENCE=serviq
