AI_MODEL_MODE=stub            # stub | ollama
AI_VISION_MODEL=moondream
AI_TEXT_MODEL=qwen2.5:3b
OLLAMA_HOST=http://ollama:11434
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=serviq
RABBITMQ_PASS=serviq
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=serviq
MINIO_ROOT_PASSWORD=serviq-local

# JWT verification (api-security env contract): IAM is the sole issuer.
# Resolution order: JWT_PUBLIC_KEY (RS256) → JWKS → JWT_SECRET (local/test only).
JWT_PUBLIC_KEY=
JWT_SECRET=
JWT_JWKS_URL=http://identity-access-backend/.well-known/jwks.json
JWT_ISSUER=serviq-iam
JWT_AUDIENCE=serviq
REDIS_HOST=redis
REDIS_PORT=6379

# Upstream APIs the chat tools call (caller's JWT forwarded verbatim).
SERVICE_MGMT_URL=http://service-management-backend
CRM_URL=http://customer-request-backend
WORKFORCE_URL=http://workforce-backend
DISPATCH_URL=http://assignment-dispatch-backend
SUPPORT_URL=http://customer-support-backend
BILLING_URL=http://billing-backend
