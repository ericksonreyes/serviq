# ServIQ AI Agent — local Docker environment.
# Copy to .env (scripts/install.sh does this for all services). Hosts are
# compose service names — never localhost inside containers.

# AI Agent boundary: document parsing, bill/coin counting, info retrieval.
# No database access — it calls domain APIs and propagates the caller's JWT.

OLLAMA_HOST=http://ollama:11434
# moondream ~1.7GB — lightest viable vision model. Swap to qwen2.5vl:3b (~3GB)
# if e-wallet screenshot accuracy proves insufficient; the 4GB ollama cap fits either.
OLLAMA_VISION_MODEL=moondream
OLLAMA_TEXT_MODEL=qwen2.5:3b

# Vector search adapter — pgvector inside the shared Postgres instance
VECTOR_DSN=postgresql://serviq:serviq@postgres:5432/serviq_ai

RABBITMQ_URL=amqp://serviq:serviq@rabbitmq:5672
REDIS_HOST=redis
REDIS_PORT=6379

# Object storage (MinIO locally) — uploads land here before parsing
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=serviq
MINIO_SECRET_KEY=serviq-local
MINIO_BUCKET=serviq-files

# Domain APIs that tools may call (compose service names)
BILLING_URL=http://billing-backend
CUSTOMER_REQUEST_URL=http://customer-request-backend
SERVICE_JOB_URL=http://service-job-backend
WORKFORCE_URL=http://workforce-backend
PAYOUTS_URL=http://payouts-backend
CUSTOMER_SUPPORT_URL=http://customer-support-backend

JWT_PUBLIC_KEY=
JWT_ISSUER=serviq-iam
JWT_AUDIENCE=serviq
