# ── Model providers (ports/adapters — app/providers/) ──────────────────
# Each capability picks a provider; shared AI_* vars are the default tier,
# per-capability AI_<CAP>_* vars override them for hybrid setups.
AI_VISION_PROVIDER=stub     # stub | ollama | openai | anthropic | gemini
AI_TEXT_PROVIDER=stub       # stub | ollama | openai | anthropic | gemini
AI_VISION_MODEL=            # model id/tag — provider default when empty
AI_TEXT_MODEL=
AI_API_KEY=                 # credential for the selected provider(s)
AI_BASE_URL=                # endpoint override — provider default when empty
AI_VISION_TIMEOUT=300

# Per-capability overrides — only needed when vision and text use
# different vendors (each falls back to the shared AI_* var above):
# AI_VISION_API_KEY=        # falls back to AI_API_KEY
# AI_TEXT_API_KEY=
# AI_VISION_BASE_URL=       # falls back to AI_BASE_URL
# AI_TEXT_BASE_URL=
# AI_TEXT_TIMEOUT=          # falls back to AI_TIMEOUT → provider default

# ── Example: local Ollama (default dev stack) ──
# AI_VISION_PROVIDER=ollama
# AI_TEXT_PROVIDER=ollama
# AI_VISION_MODEL=moondream
# AI_TEXT_MODEL=qwen2.5:3b
# AI_BASE_URL=http://ollama:11434

# ── Example: OpenAI ──
# AI_VISION_PROVIDER=openai
# AI_TEXT_PROVIDER=openai
# AI_VISION_MODEL=gpt-4o-mini
# AI_TEXT_MODEL=gpt-4o-mini
# AI_API_KEY=sk-...
# Also covers OpenAI-compatible endpoints (OpenRouter, vLLM, LiteLLM
# gateways) — point AI_BASE_URL at the gateway.

# ── Example: Anthropic (no free tier; wire-tested, not live-validated) ──
# AI_VISION_PROVIDER=anthropic
# AI_TEXT_PROVIDER=anthropic
# AI_VISION_MODEL=claude-haiku-4-5
# AI_TEXT_MODEL=claude-haiku-4-5
# AI_API_KEY=sk-ant-...

# ── Example: Google Gemini ──
# AI_VISION_PROVIDER=gemini
# AI_TEXT_PROVIDER=gemini
# AI_VISION_MODEL=gemini-3-flash-preview
# AI_TEXT_MODEL=gemini-3-flash-preview
# AI_API_KEY=...
# If the model above 404s (retired) or 503s (saturated), try
# gemini-3.8-flash or gemini-flash-latest — ListModels on your key shows
# what it can reach.

# ── Example: hybrid — local Ollama text + cloud vision ──
# AI_TEXT_PROVIDER=ollama
# AI_TEXT_MODEL=qwen2.5:3b
# AI_TEXT_BASE_URL=http://ollama:11434
# AI_VISION_PROVIDER=gemini
# AI_VISION_MODEL=gemini-3-flash-preview
# AI_VISION_API_KEY=...

RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=serviq
RABBITMQ_PASS=serviq
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=serviq
MINIO_ROOT_PASSWORD=serviq-local

# JWT verification (api-security env contract): IAM is the sole issuer.
# Resolution order: JWT_PUBLIC_KEY (RS256) → JWKS → JWT_SECRET (local/test only).
JWT_PUBLIC_KEY=
JWT_SECRET=
JWT_JWKS_URL=http://identity-access-backend/.well-known/jwks.json
JWT_ISSUER=serviq-iam
JWT_AUDIENCE=serviq
REDIS_HOST=redis
REDIS_PORT=6379

# Upstream APIs the chat tools call (caller's JWT forwarded verbatim).
SERVICE_MGMT_URL=http://service-management-backend
CRM_URL=http://customer-request-backend
WORKFORCE_URL=http://workforce-backend
DISPATCH_URL=http://assignment-dispatch-backend
SUPPORT_URL=http://customer-support-backend
BILLING_URL=http://billing-backend
