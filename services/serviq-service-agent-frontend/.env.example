# ServIQ Service Agent (frontend PWA) — local Docker environment.
# Copy to .env (scripts/install.sh does this for all services).
# NOTE: VITE_* values are read at build time and must use localhost —
# the browser cannot resolve compose service names.

VITE_API_BASE_URL=http://localhost:8001

# Auth calls go to IAM's public edge directly; data calls go to the BFF.
VITE_IDENTITY_API_URL=http://localhost:8010
