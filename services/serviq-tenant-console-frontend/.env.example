# ServIQ Tenant Console (frontend) — local Docker environment.
# Copy to .env (scripts/install.sh does this for all services).
# NOTE: VITE_* values are read at build time and must use localhost —
# the browser cannot resolve compose service names.
# Admin APIs are browser-facing (see security/INTERNAL_SERVICE_SECURITY.MD).

VITE_IDENTITY_API_URL=http://localhost:8010
VITE_PLATFORM_API_URL=http://localhost:8011
VITE_SERVICE_API_URL=http://localhost:8012
VITE_CRM_API_URL=http://localhost:8013
VITE_JOB_API_URL=http://localhost:8014
VITE_WORKFORCE_API_URL=http://localhost:8015
VITE_DISPATCH_API_URL=http://localhost:8016
VITE_FIELD_API_URL=http://localhost:8017
VITE_SUPPORT_API_URL=http://localhost:8018
VITE_NOTIFICATION_API_URL=http://localhost:8019
VITE_BILLING_API_URL=http://localhost:8020
VITE_PAYOUTS_API_URL=http://localhost:8021
VITE_AI_AGENT_API_URL=http://localhost:8100
