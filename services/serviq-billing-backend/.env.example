# ServIQ Billing — local Docker environment.
# Copy to .env (scripts/install.sh does this for all services). Hosts are
# compose service names — never localhost inside containers.

APP_NAME="ServIQ Billing"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8020

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=serviq_billing
DB_USERNAME=serviq
DB_PASSWORD=serviq

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=serviq
RABBITMQ_PASSWORD=serviq

# S3-compatible object storage (MinIO locally) — payment evidence documents
FILESYSTEM_DISK=s3
AWS_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=serviq
AWS_SECRET_ACCESS_KEY=serviq-local
AWS_DEFAULT_REGION=local
AWS_BUCKET=serviq-files
AWS_USE_PATH_STYLE_ENDPOINT=true

JWT_PUBLIC_KEY=
JWT_ISSUER=serviq-iam
JWT_AUDIENCE=serviq
