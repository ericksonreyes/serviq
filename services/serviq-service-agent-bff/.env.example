# ServIQ Service Agent BFF — local Docker environment.
# Copy to .env (scripts/install.sh does this for all services). Hosts are
# compose service names — never localhost inside containers.

NODE_ENV=production
PORT=3000
# NestJS runs --max-old-space-size=256 per the local resource budget

REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_URL=amqp://serviq:serviq@rabbitmq:5672

# Downstream domain APIs (compose service names)
IDENTITY_ACCESS_URL=http://identity-access-backend
ASSIGNMENT_DISPATCH_URL=http://assignment-dispatch-backend
FIELD_SERVICE_URL=http://field-service-backend
SERVICE_JOB_URL=http://service-job-backend
WORKFORCE_URL=http://workforce-backend
PAYOUTS_URL=http://payouts-backend
BILLING_URL=http://billing-backend

JWT_PUBLIC_KEY=
JWT_ISSUER=serviq-iam
JWT_AUDIENCE=serviq
