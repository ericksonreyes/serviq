# ServIQ Identity & Access — local Docker environment.
# Copy to .env (scripts/install.sh does this for all services). Hosts are
# compose service names — never localhost inside containers.

APP_NAME="ServIQ Identity & Access"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8010

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=serviq_identity
DB_USERNAME=serviq
DB_PASSWORD=serviq

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=serviq
RABBITMQ_PASSWORD=serviq
RABBITMQ_EXCHANGE=serviq.events
RABBITMQ_QUEUE=identity-access.events

# JWT issuance — IAM is the sole issuer; signs RS256 (ADR-0001).
# Other services only ever receive the public key (JWT_PUBLIC_KEY).
# If JWT_PRIVATE_KEY is empty, the container entrypoint generates a local
# keypair into storage/keys/ — never commit real keys.
# JWT_SECRET is the local/test symmetric fallback only (HS256); it is ignored
# whenever a private key is available. Never use it in production.
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_SECRET=
JWT_ISSUER=serviq-iam
JWT_AUDIENCE=serviq
JWT_TTL=3600
JWT_REFRESH_TTL=2592000

# Local seeding — first-boot credentials for the platform scope.
# Change for anything beyond local development.
IAM_SEED_ADMIN_USERNAME=admin
IAM_SEED_ADMIN_PASSWORD=serviq-local
